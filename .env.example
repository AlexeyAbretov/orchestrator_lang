# Токен с правом записи issues.
# Classic: scope repo. Fine-grained: Issues — Read and write.
GITHUB_TOKEN=

# Репозиторий в формате owner/name
GITHUB_REPO=AlexeyAbretov/orchestrator_lang

# Пауза между проходами, в секундах. Минимум 5.
POLL_INTERVAL_SECONDS=60

# Ключ Cursor: Dashboard → Integrations, либо service account команды.
CURSOR_API_KEY=

# Репозиторий, в котором аналитик разбирает реализацию issue.
CURSOR_REPO_URL=https://github.com/AlexeyAbretov/budget_app
CURSOR_STARTING_REF=main
CURSOR_MODEL=composer-2.5
CURSOR_FAST=false
